{
  "name": "Signal K Server",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:24",
  "forwardPorts": [
    3000
  ],
  "portsAttributes": {
    "3000": {
      "label": "Signal K Server",
      "onAutoForward": "notify"
    }
  },
  // Share one pnpm store across sibling worktrees via a bind-mounted sibling directory.
  // The global virtual store lives inside it too, so packages are hard-linked (not copied)
  // and the worktree's node_modules holds only symlinks into the bind mount.
  "mounts": [
    "source=${localWorkspaceFolder}/../pnpm-store,target=/home/node/.local/share/pnpm/store,type=bind",
    "source=${localWorkspaceFolder}/..,target=${localWorkspaceFolder}/..,type=bind,consistency=cached"
  ],
  "onCreateCommand": "sudo chown -R node:node /home/node/.local/share/pnpm",
  "postCreateCommand": "sudo corepack enable && corepack install && pnpm config set --global store-dir /home/node/.local/share/pnpm/store && pnpm config set --global enable-global-virtual-store true && pnpm install",
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "eslint.format.enable": true
      }
    }
  },
  "remoteUser": "node"
}